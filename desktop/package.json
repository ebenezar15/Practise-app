{
  "name": "cadenza-desktop",
  "productName": "Cadenza",
  "version": "2.0.2",
  "description": "Cadenza \u2014 offline AI practice coach for piano, guitar, bass & trumpet, with a built-in classroom server",
  "main": "main.js",
  "author": "Cadenza",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare-app": "node ../scripts/build-desktop.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-app && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.cadenza.practice",
    "productName": "Cadenza",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "artifactName": "Cadenza-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cadenza",
      "artifactName": "Cadenza-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Cadenza-${version}-windows-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cadenza listens to your instrument to coach you in real time. Audio never leaves your computer.",
        "LSMinimumSystemVersion": "10.15"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "Cadenza <hello@cadenza.app>"
    },
    "publish": null,
    "afterPack": "build/after-pack.js",
    "dmg": {
      "title": "Cadenza ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 450,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 300,
          "y": 360,
          "type": "file",
          "path": "build/How to open on Mac.txt"
        }
      ],
      "window": {
        "width": 600,
        "height": 460
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ebenezar15/Practise-app.git"
  }
}
